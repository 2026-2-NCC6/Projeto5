{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Tennis Arena — REST API Oficial",
    "version": "1.2.0",
    "description": "API versionada do ecossistema Smart Tennis Arena (6º CCOMP FECAP 2026). Cobre autenticação RBAC, proteção LGPD de menores, catálogo e versionamento de treinos, metadados de marketplace, sincronização idempotente de sessões/telemetria, pareamento seguro IoT, parada de emergência (!EMG) e integração com a Plataforma Mãe SmartTennis."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API Oficial Versionada (v1)"
    },
    {
      "url": "/api",
      "description": "Alias Retrocompatível"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Observabilidade"
        ],
        "summary": "Health check do servidor, banco MySQL e métricas de latência",
        "responses": {
          "200": {
            "description": "Serviço operacional"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Autenticação & LGPD (RF01, RF02)"
        ],
        "summary": "Auto-cadastro público de praticante (restrito ao perfil JOGADOR + consentimento parental para KIDS)",
        "responses": {
          "201": {
            "description": "Conta criada com token JWT"
          },
          "403": {
            "description": "Tentativa bloqueada de escalonamento de privilégio"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação & LGPD (RF01, RF02)"
        ],
        "summary": "Autenticação com e-mail e senha (protegido por rate limit)",
        "responses": {
          "200": {
            "description": "Autenticado com sucesso"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Autenticação & LGPD (RF01, RF02)"
        ],
        "summary": "Encerra a sessão revogando o JWT atual e registrando LOGOUT na auditoria",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sessão revogada"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Autenticação & LGPD (RF01, RF02)"
        ],
        "summary": "Obtém dados e perfil RF02 do usuário autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do titular"
          }
        }
      },
      "delete": {
        "tags": [
          "Autenticação & LGPD (RF01, RF02)"
        ],
        "summary": "Exclusão da própria conta pelo titular (Direito LGPD)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Conta excluída"
          }
        }
      }
    },
    "/auth/profile": {
      "put": {
        "tags": [
          "Autenticação & LGPD (RF01, RF02)"
        ],
        "summary": "Atualiza nível técnico, objetivos, preferências, restrições físicas e consentimento de telemetria",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil atualizado"
          }
        }
      }
    },
    "/drills": {
      "get": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Lista catálogo de treinos com filtros por público, dificuldade, categoria, duração e sensores",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "difficulty",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "targetAudience",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isKidsAdapted",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "maxDurationSec",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sensor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de treinos compatíveis"
          }
        }
      },
      "post": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Cria novo treino em DRAFT com parâmetros Spinshot e metadados de Marketplace (TREINADOR/ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Rascunho criado e versionado"
          }
        }
      }
    },
    "/drills/validate": {
      "post": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Valida regras, janelas de sensores e limites de segurança Spinshot antes da publicação (RF15)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado determinístico da validação"
          }
        }
      }
    },
    "/drills/{id}": {
      "get": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Retorna definição completa, instruções pré-sessão (RF04) e metadados comerciais (RF20)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Definição completa do treino"
          }
        }
      },
      "put": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Edita treino existente gerando nova versão e entrada no changelog (RF14, RF16)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Treino atualizado"
          }
        }
      }
    },
    "/drills/{id}/versions": {
      "get": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Consulta histórico imutável de versões, compatibilidade e changelog do treino (RF16, RF18)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Histórico de versões"
          }
        }
      }
    },
    "/drills/{id}/status": {
      "post": {
        "tags": [
          "Treinos, Versionamento & Marketplace (RF03, RF16, RF18, RF20)"
        ],
        "summary": "Altera status do ciclo de vida (DRAFT -> IN_REVIEW -> PUBLISHED -> ARCHIVED) com validação formal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status atualizado e sincronizado com a Plataforma Mãe"
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "tags": [
          "Sessões, Telemetria & Analytics (RF12, RF13, RF19, RF21)"
        ],
        "summary": "Sincroniza resumo e telemetria (quando consentido via LGPD) com chave de idempotência",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Replay idempotente reconhecido sem duplicação"
          },
          "201": {
            "description": "Sessão persistida e encaminhada à Plataforma Mãe"
          }
        }
      },
      "get": {
        "tags": [
          "Sessões, Telemetria & Analytics (RF12, RF13, RF19, RF21)"
        ],
        "summary": "Lista sessões filtradas por período, treino, status e atleta (com proteção LGPD Kids)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "drillId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "anonymize",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Histórico de sessões"
          }
        }
      }
    },
    "/sessions/analytics": {
      "get": {
        "tags": [
          "Sessões, Telemetria & Analytics (RF12, RF13, RF19, RF21)"
        ],
        "summary": "Retorna métricas consolidadas de precisão, consistência, tempo, volume e curva de progressão (RF13)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Indicadores analíticos e recomendações"
          }
        }
      }
    },
    "/sessions/{id}": {
      "get": {
        "tags": [
          "Sessões, Telemetria & Analytics (RF12, RF13, RF19, RF21)"
        ],
        "summary": "Detalhes completos de uma sessão e linha do tempo de eventos dos sensores",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessão detalhada"
          }
        }
      }
    },
    "/incidents": {
      "post": {
        "tags": [
          "Segurança Física & Parada de Emergência (RF22, RF23)"
        ],
        "summary": "Registra acionamento de !EMG, perda de comunicação ou falha de sensor com motivo",
        "responses": {
          "201": {
            "description": "Incidente crítico registrado"
          }
        }
      },
      "get": {
        "tags": [
          "Segurança Física & Parada de Emergência (RF22, RF23)"
        ],
        "summary": "Lista incidentes de parada segura e falhas na arena (TREINADOR/ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de incidentes"
          }
        }
      }
    },
    "/incidents/{id}/resolve": {
      "patch": {
        "tags": [
          "Segurança Física & Parada de Emergência (RF22, RF23)"
        ],
        "summary": "Registra verificação e reinício seguro após parada de emergência",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incidente resolvido"
          }
        }
      }
    },
    "/devices": {
      "get": {
        "tags": [
          "Dispositivos IoT & Gestão Administrativa (RF05, RF17)"
        ],
        "summary": "Lista controladores IoT, status de comunicação e saúde dos 5 sensores piezoelétricos",
        "responses": {
          "200": {
            "description": " Controladores IoT cadastrados"
          }
        }
      },
      "post": {
        "tags": [
          "Dispositivos IoT & Gestão Administrativa (RF05, RF17)"
        ],
        "summary": "Cadastra novo controlador IoT gerando token protegido por hash (ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Dispositivo criado"
          }
        }
      }
    },
    "/devices/pair": {
      "post": {
        "tags": [
          "Dispositivos IoT & Gestão Administrativa (RF05, RF17)"
        ],
        "summary": "Autentica pareamento autorizado do controlador IoT via token e atualiza status dos sensores (RF05)",
        "responses": {
          "200": {
            "description": "Controlador autenticado"
          },
          "401": {
            "description": "Token inválido"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Dispositivos IoT & Gestão Administrativa (RF05, RF17)"
        ],
        "summary": "Lista categorias oficiais de treinos e marketplace",
        "responses": {
          "200": {
            "description": "Categorias ativas"
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "Dispositivos IoT & Gestão Administrativa (RF05, RF17)"
        ],
        "summary": "Lista parâmetros gerais de operação, limites de velocidade e segurança da Arena",
        "responses": {
          "200": {
            "description": "Configurações do sistema"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Usuários & Auditoria (RF01, RF17, RF23)"
        ],
        "summary": "Lista usuários aplicando política LGPD de menores e opção ?anonymize=true (TREINADOR/ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuários listados"
          }
        }
      },
      "post": {
        "tags": [
          "Usuários & Auditoria (RF01, RF17, RF23)"
        ],
        "summary": "Criação administrativa de contas incluindo TREINADOR e ADMIN (ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Usuário criado"
          }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "tags": [
          "Usuários & Auditoria (RF01, RF17, RF23)"
        ],
        "summary": "Trilha de auditoria completa com correlationId e severidade (ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logs de auditoria"
          }
        }
      }
    },
    "/mother-platform/catalog": {
      "get": {
        "tags": [
          "Integração Plataforma Mãe SmartTennis (RF18, RF19)"
        ],
        "summary": "Catálogo padronizado compatível com a Plataforma Mãe SmartTennis",
        "responses": {
          "200": {
            "description": "Catálogo interoperável"
          }
        }
      }
    },
    "/mother-platform/sync-logs": {
      "get": {
        "tags": [
          "Integração Plataforma Mãe SmartTennis (RF18, RF19)"
        ],
        "summary": "Evidências auditáveis de sincronização de treinos e sessões com a Plataforma Mãe",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recibos de sincronização"
          }
        }
      }
    }
  }
}