PORT=3001
NODE_ENV=development
JWT_SECRET=seu_segredo_jwt_super_seguro_min_32_caracteres
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS (separadas por vírgula; em development permite localhost e rede local)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Limites de proteção contra força bruta (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=25

# Integração com a Plataforma Mãe SmartTennis (RF18, RF19 — 'mock' local ou 'external')
MOTHER_PLATFORM_MODE=mock
MOTHER_PLATFORM_URL=http://localhost:3001/api/v1/mother-platform
MOTHER_PLATFORM_API_KEY=

# Token inicial de pareamento autorizado do controlador IoT protótipo (RF05 / Cibersegurança IoT)
IOT_DEFAULT_PAIRING_TOKEN=sta-iot-uno-r3-demo-token-2026

# Configuração do MySQL Local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_tennis_arena

# Configuração para Nuvem (Compatível com Railway, Render, Supabase, AWS RDS, etc.)
# DATABASE_URL=mysql://root:password@host:3306/smart_tennis_arena
